# Normalize line endings: LF in the repository and in the working copy
* text=auto eol=lf

# Sources
*.php   text diff=php
*.js    text
*.mjs   text
*.jsx   text
*.css   text diff=css
*.html  text diff=html
*.json  text
*.md    text diff=markdown
*.svg   text

# Lockfile: no noisy diffs in reviews
package-lock.json  -diff linguist-generated

# Binaries
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.sqlite  binary
*.zip     binary
